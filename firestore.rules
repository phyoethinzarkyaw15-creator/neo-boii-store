rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Validation Blueprint: Product (MMK Store Schema)
    function isValidProduct(data) {
      return data.keys().hasAll([
          'id',
          'name',
          'price',
          'currency',
          'status',
          'description',
          'features',
          'images',
          'mainImage',
          'importantNotes',
          'published',
          'authorId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'name',
          'price',
          'currency',
          'status',
          'description',
          'features',
          'images',
          'mainImage',
          'importantNotes',
          'published',
          'authorId',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id.size() >= 2 && data.id.size() <= 64 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.price is number && data.price >= 0 && data.price <= 100000000
        && data.currency is string && data.currency.size() == 3 && data.currency == 'MMK'
        && data.status is string && data.status.size() >= 7 && data.status.size() <= 20 && (data.status == 'AVAILABLE' || data.status == 'SOLD OUT')
        && data.description is string && data.description.size() <= 2000
        && data.features is list && data.features.size() <= 10
        && data.images is list && data.images.size() <= 8
        && data.mainImage is string && data.mainImage.size() <= 500000
        && data.importantNotes is string && data.importantNotes.size() <= 1000
        && data.published is bool
        && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Products Collection (Direct Admin Panel & Public Store Access)
    match /products/{productId} {
      allow get: if isValidId(productId);

      allow list: if true;

      allow create: if isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(productId);
    }
  }
}
